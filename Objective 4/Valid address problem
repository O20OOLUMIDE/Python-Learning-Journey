# Valid address problem

# Subroutine that returns whether an email is valid
def valid_email(email_address):
    if "@" not in email_address or "." not in email_address:
        return False

    at_index = email_address.index("@")
    dot_index = email_address.index(".")

    if dot_index > at_index:
        return True
    else:
        return False
        
# Main program
email_address = input("Enter your email address: ").strip()
answer = valid_email(email_address)

print(f"The validity of your email address is: {answer}")
