# Ball pit problem
import math 

# Subroutine to calculate volume of a ball pit
def calculate_ballpit_volume(pit_radius, pit_height):
    pit_volume = math.pi * pit_radius ** 2 * pit_height  
    return pit_volume  # return computed pit volume for reuse

# Subroutine to calculate volume of a ball
def calculate_ball_volume(ball_radius):
    ball_volume = (4 / 3) * math.pi * ball_radius ** 3  
    return ball_volume  # return computed ball volume for reuse


# Subroutine to calculate the number of balls needed to fill a childrens pit
def estimate_ball_count(pit_volume, ball_volume, packing_density):
    ball_count = (pit_volume / ball_volume) * packing_density
    return ball_count  # return estimated number of balls

# Main program
pit_radius = 1.5
pit_height = 0.6
ball_radius = 0.07
packing_density = 0.65

pit_volume = calculate_ballpit_volume(pit_radius, pit_height)
ball_volume = calculate_ball_volume(ball_radius)

required_ball_count = estimate_ball_count(pit_volume, ball_volume, packing_density)

print("The number of balls required to fill in the children’s pit is: {:.0f}".format(required_ball_count))
