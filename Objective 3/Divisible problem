# Divisible problem

# Subroutine that outputs whether numbers are divisible by each other
def divisible(num1, num2):
    if num2 == 0:
        return False
    if num2 % num1 == 0:
        return True
    else:
        return False


# Main program
num1 = int(input("Enter the 1st number (has to be greater than 0): ").strip())
num2  = int(input("Enter the 2nd number: ").strip())

answer = divisible(num1, num2)
print(f"The validity of the divisibility of numbers is {answer}")
