# FizzBuzz problem

def fizz_buzz(X):
    for counter in range(1, X + 1):
        if counter % 5 == 0 and counter % 3 == 0:
            print("FizzBuzz")

        elif counter % 3 == 0:
            print("Fizz")

        elif counter % 5 == 0:
            print("Buzz")

        else:
            print(counter)
            

# Main program
X = int(input("Enter the number of times you want loop to be repeated: "))
fizz_buzz(X)
